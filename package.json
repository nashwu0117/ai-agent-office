{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/core",
    "packages/adapters/claude-code",
    "packages/adapters/opencode",
    "packages/adapters/master-anthropic",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
